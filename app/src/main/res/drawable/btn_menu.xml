<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFB8860B" android:endColor="#FF8B5A2B" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FFE8D9A0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF8B5A2B" android:endColor="#FF5D3A1A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FFC8A96A" />
        </shape>
    </item>
</selector>
